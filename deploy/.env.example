# Copy to deploy/.env on the VPS and fill in (spec §6). .env is git-ignored: never commit it (spec C4).
# Keys use __ for the configuration section separator. Lists use :0, :1, ... as __0, __1, ...
# Do not leave a line with an empty value: an empty number or flag fails at startup. Delete the line instead.

# --- Secrets: reader account (my.telegram.org) and session ---------------------------------------------
Telegram__ApiId=
Telegram__ApiHash=
Telegram__PhoneNumber=
# Must be the same key the session file was created with (`login`). Hex of 32, 48 or 64 characters: openssl rand -hex 32
Telegram__SessionKey=

# --- Identifying: monitored sources (marked chat ids from `list-chats`) ---------------------------------
Monitoring__Sources__0__ChatId=
Monitoring__Sources__0__Name=
# Monitoring__Sources__1__ChatId=
# Monitoring__Sources__1__Name=

# --- Secrets / identifying: bot, test group, labelers --------------------------------------------------
Notifications__BotToken=
Notifications__TargetChatId=
Notifications__LabelerUserIds__0=
# Notifications__LabelerUserIds__1=

# --- Experiment settings (pre-run checklist in README.md; not secret) -----------------------------------
Notifications__Enabled=true
Storage__StoreUnmatchedText=true
# Experiment length + 1 day, so `rescan` still sees every unmatched text at the end (spec default: 3).
Storage__UnmatchedRetentionDays=8

# --- Optional: spec defaults shown; uncomment to change --------------------------------------------------
# Monitoring__EditHandling=NotifyOnNewMatch
# Notifications__MaxMessageAgeSeconds=120
# Notifications__DisplayTimeZone=Europe/Kyiv
# Reporting__DailyReportEnabled=true
# Reporting__DailyReportLocalTime=09:00
# Device the reader account shows in Telegram > Settings > Devices; keep it the same on every host (AC-F1.9).
# Telegram__DeviceModel=Skywatch
# Telegram__SystemVersion=Server
# Telegram__AppVersion=1.0
# Telegram__LangCode=uk
