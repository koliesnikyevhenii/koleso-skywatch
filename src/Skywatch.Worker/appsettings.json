{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Telegram": {
    "ApiId": 0,
    "ApiHash": "",
    "PhoneNumber": "",
    "SessionPath": "data/session.dat",
    "SessionKey": "",
    "UpdateStatePath": "data/updates.state",
    "UpdateStateSaveIntervalSeconds": 60
  },
  "Monitoring": {
    "EditHandling": "NotifyOnNewMatch",
    "EditDebounceSeconds": 15,
    "Patterns": [
      { "Name": "Settlement", "Regex": "\\bкрасно[-\\s]?павл(?:івк|івц|овк)\\w*", "CaseSensitive": false, "Enabled": true },
      { "Name": "Adjective", "Regex": "\\bкрасно[-\\s]?павл(?:івськ|овск)\\w*", "CaseSensitive": false, "Enabled": true },
      { "Name": "Abbreviation", "Regex": "\\b(?i:на|в|у|над|по|біля|возле|до|через|під|под)\\s+К[Пп]\\b", "CaseSensitive": true, "Enabled": true },
      { "Name": "Colloquial", "Regex": "\\bкраснопе\\b", "CaseSensitive": false, "Enabled": true }
    ],
    "Sources": []
  },
  "Notifications": {
    "TargetChatId": 0,
    "LabelerUserIds": []
  }
}
